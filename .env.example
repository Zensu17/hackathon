# Leave VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY blank to run LiteLearn
# in local IndexedDB fallback mode for offline development and automated tests.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Comma-separated campus email domains permitted during account creation.
VITE_ALLOWED_EMAIL_DOMAINS=students.del.ac.id,del.ac.id
